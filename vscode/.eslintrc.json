{
  "parser": "@typescript-eslint/parser",
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "rules": {
    "@typescript-eslint/naming-convention": [
      "warn",
      {
        "selector": "class",
        "format": [
          "PascalCase"
        ]
      },
      {
        "selector": "function",
        "format": [
          "camelCase"
        ]
      }
    ],
    "@typescript-eslint/semi": [
      "warn",
      "always"
    ],
    "curly": "warn",
    "@typescript-eslint/no-unused-vars": "warn",
    "no-undef": "off"
  },
  "ignorePatterns": [
    "out",
    "dist",
    "**/*.d.ts"
  ]
}