{
  "name": "ramz-language-support",
  "displayName": "Ramz Language Support (لغة رمز)",
  "description": "دعم كامل للغة برمجة رمز - Full support for Ramz programming language",
  "version": "0.1.0",
  "publisher": "laamiriouail",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ramz",
    "رمز",
    "arabic",
    "programming language",
    "RTL"
  ],
  "activationEvents": [
    "onLanguage:ramz",
    "onCommand:ramz.run",
    "onCommand:ramz.check"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/LaamiriOuail/Ramz.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "ramz",
        "aliases": [
          "Ramz",
          "رمز",
          "ramz"
        ],
        "extensions": [
          ".ramz",
          ".رمز"
        ]
      }
    ],
    "grammars": [
      {
        "language": "ramz",
        "scopeName": "source.ramz",
        "path": "./syntaxes/ramz.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  }
}
