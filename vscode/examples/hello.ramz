# برنامج مرحبا بالعالم - Hello World Program

اكتب("مرحباً بالعالم!")

# إعلان متغيرات - Variable Declarations
متغير الاسم = "أحمد"
متغير العمر: رقم = 25
متغير النشط = صحيح

# جملة شرطية - If Statement
إذا العمر >= 18:
    اكتب("أنت بالغ!")
وإلا:
    اكتب("أنت قاصر")

# حلقة تكرار - Loop
لكل i من 1 إلى 5:
    اكتب("الرقم: " + i)

# دالة - Function
دالة مرحبا() {
    اكتب("مرحباً من دالة!")
}

# استدعاء الدالة - Function Call
ادع مرحبا()