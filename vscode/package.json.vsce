{
  "name": "ramz-language",
  "displayName": "Ramz Language Support (لغة رمز)",
  "description": "دعم كامل للغة برمجة رمز - Full support for Ramz programming language",
  "version": "0.1.0",
  "publisher": "laamiriouail",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ramz",
    "رمز",
    "arabic",
    "programming language",
    "RTL"
  ],
  "activationEvents": [
    "onLanguage:ramz",
    "onCommand:ramz.run",
    "onCommand:ramz.check"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ramz",
        "aliases": [
          "Ramz",
          "رمز",
          "ramz"
        ],
        "extensions": [
          ".ramz",
          ".رمز"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  }
}
