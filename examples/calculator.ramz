# آلة حاسبة بسيطة
# تتنفذ العمليات الحسابية الأساسية

اكتب("=== آلة حاسبة بسيطة ===")
اكتب("")

متغير رقم1 = اقرأ("أدخل الرقم الأول: ")
متغير الرمز = اقرأ("اختر العملية (+, -, *, /): ")
متغير رقم2 = اقرأ("أدخل الرقم الثاني: ")

اكتب("")

إذا الرمز == "+":
    متغير النتيجة = رقم1 + رقم2
    اكتب("المجموع: " + النتيجة)
وإلا إذا الرمز == "-":
    متغير النتيجة = رقم1 - رقم2
    اكتب("الفرق: " + النتيجة)
وإلا إذا الرمز == "*":
    متغير النتيجة = رقم1 * رقم2
    اكتب("الحاصل: " + النتيجة)
وإلا إذا الرمز == "/":
    متغير النتيجة = رقم1 / رقم2
    اكتب("القسمة: " + النتيجة)
وإلا:
    اكتب("عملية غير صالحة!")