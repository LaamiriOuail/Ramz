# برنامج إدارة الطلاب
# يعرض قائمة طلاب ودرجاتهم

اكتب("=== قائمة الطلاب ===")
اكتب("")

# إنشاء قائمة الطلاب
متغير الطلاب = [
    {"الاسم": "أحمد", "الدرجة": 95},
    {"الاسم": "محمد", "الدرجة": 87},
    {"الاسم": "خالد", "الدرجة": 92},
    {"الاسم": "سارة", "الدرجة": 88}
]

# طباعة القائمة
اكتب("عدد الطلاب: " + 4)
اكتب("")

# معلومات الطالب الأول
اكتب("الطالب الأول:")
اكتب("الاسم: أحمد")
اكتب("الدرجة: 95")

اكتب("")

# معلومات الطالب الثاني
اكتب("الطالب الثاني:")
اكتب("الاسم: محمد")
اكتب("الدرجة: 87")

اكتب("")

# حساب المجموع
متغير المجموع = 95 + 87 + 92 + 88
متغير المتوسط = المجموع / 4

اكتب("=== الإحصائيات ===")
اكتب("مجموع الدرجات: " + المجموع)
اكتب("متوسط الدرجات: " + المتوسط)