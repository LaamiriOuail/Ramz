# برنامج حساب العمر
# يحسب السنة التي سيصبح فيها المستخدم عمر 100 سنة

اكتب("=== حساب السنة التي ستكون فيها عمر 100 ===")
اكتب("")

متغير العمر_الحالي = اقرأ("كم عمرك الحالي؟ ")
متغير السنة_الحالية = اقرأ("ما السنة الحالية؟ ")

اكتب("")
متغير السنوات_المتبقية = 100 - العمر_الحالي
متغير السنة_المستقبلية = السنة_الحالية + السنوات_المتبقية

اكتب("عمرك الحالي: " + العمر_الحالي)
اكتب("السنة الحالية: " + السنة_الحالية)
اكتب("السنوات المتبقية لتصل لـ 100: " + السنوات_المتبقية)
اكتب("")
اكتب("في سنة " + السنة_المستقبلية + " سيكون عمرك 100 سنة!")