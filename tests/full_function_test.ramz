# Test 1: Simple function with no parameters
دالة hello() {
    ارجع "مرحباً"
}

اكتب(ادع hello())

# Test 2: Function with one parameter
دالة greet(name) {
    ارجع "مرحباً " + name
}

اكتب(ادع greet("العالم"))

# Test 3: Function with multiple parameters
دالة add(a, b) {
    ارجع a + b
}

متغير result = ادع add(10, 5)
اكتب(result)

# Test 4: Function that calls another function
دالة double(x) {
    ارجع x + x
}

دالة quadruple(x) {
    ارجع ادع double(ادع double(x))
}

اكتب(ادع quadruple(5))
